@page "/transaction-daily-balance"
@rendermode InteractiveServer

@inject TransactionBalanceApiClient TransactionBalanceApi


<h3 class="mb-4">Daily Balance</h3>
<div class="d-flex gap-2 mb-3">
    <input class="form-control form-control-sm"
           style="max-width: 180px;"
           type="date"
           @bind="filterStart"
           @bind:format="yyyy-MM-dd"
           @bind:after="Load" />

    <input class="form-control form-control-sm"
           style="max-width: 180px;"
           type="date"
           @bind="filterEnd"
           @bind:format="yyyy-MM-dd"
           @bind:after="Load" />
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (dailyBalances.Count == 0)
{
    <div class="alert alert-info">
        No data found.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Balance</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in dailyBalances.OrderByDescending(x => x.Date))
                    {
                        <tr class='@(item.Balance > 0 ? "table-success" : item.Balance < 0 ? "table-danger" : "")'>
                            <td>@item.Date</td>
                            <td>$@item.Balance</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<TransactionDailyBalance> dailyBalances = [];
    private bool isLoading = true;
    private string? errorMessage;

    private DateOnly? filterStart;
    private DateOnly? filterEnd;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        try
        {
            isLoading = true;

            dailyBalances = (await TransactionBalanceApi
                .GetTransactionDailyBalancesAsync(filterStart, filterEnd))
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}